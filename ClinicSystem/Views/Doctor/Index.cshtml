@{
}
@model IEnumerable<Doctor>
@{
    var i = 1;
}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<div class="container">

    <div class="row mb-3 align-items-center my-3">
        <div class="col-md-6">
            <h2 class="display-6">All Doctors</h2>
        </div>
        <div class="col-md-6 text-md-end text-start mt-2 mt-md-0">
            <a href="/Doctor/Create" class="btn btn-success">Create</a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <table class="table table-success table-striped">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Name</th>
                        <th scope="col">Specialization</th>
                        <th scope="col"> Actions</th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <th scope="row">@(i++)</th>
                            <td>@item.Name</td>
                            <td>@item.Specialization</td>
                            <td>
                                <a href="/Doctor/Edit/@item.Id" type="button" class="btn btn-warning">Edit</a>
                                <a href="javascript:;" class="btn btn-danger btn-delete" data-id="@item.Id">Delete</a>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const deleteButtons = document.querySelectorAll(".btn-delete");

        deleteButtons.forEach(button => {
            button.addEventListener("click", function () {
                const doctorId = this.getAttribute("data-id");

                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to revert this!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Redirect to your delete endpoint
                        window.location.href = `/Doctor/Delete/${doctorId}`;
                    }
                });
            });
        });
    });
</script>
