@*     //with the validation of date and time *@

           @model Doctor

@{
    ViewData["Title"] = "Complete Appointment with " + Model.Name;
}

<h1>Complete Appointment with @Model.Name</h1>

<form asp-action="BookAppointment" asp-controller="Home" method="post">
    <input type="hidden" name="doctorId" value="@Model.Id" />

    <div class="mb-3">
        <label for="PatientName" class="form-label">Patient Name</label>
        <input type="text" class="form-control" id="PatientName" name="PatientName" required />
        <span class="text-danger">
            @ViewData.ModelState["PatientName"]?.Errors.FirstOrDefault()?.ErrorMessage
        </span>
    </div>

    <div class="mb-3">
        <label for="AppointmentDate" class="form-label">Appointment Date</label>
        <input type="date" class="form-control" id="AppointmentDate" name="AppointmentDate" required />
        <span class="text-danger">
            @ViewData.ModelState["AppointmentDate"]?.Errors.FirstOrDefault()?.ErrorMessage
        </span>
    </div>

    <div class="mb-3">
        <label for="AppointmentTime" class="form-label">Appointment Time</label>
        <input type="time" class="form-control" id="AppointmentTime" name="AppointmentTime" required />
        <span class="text-danger">
            @ViewData.ModelState["AppointmentTime"]?.Errors.FirstOrDefault()?.ErrorMessage
        </span>
    </div>

    <button type="submit" class="btn btn-primary">Complete Appointment</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
