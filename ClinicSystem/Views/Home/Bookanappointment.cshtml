            </div>
        </section>




        @if (ViewBag.Message != null)
        {
            <div class="alert alert-warning text-center">
                @ViewBag.Message
            </div>
        }

        @foreach (var item in Model.DoctorsVM)
        {
            <div class="col-md-4 mb-4 d-flex justify-content-center">
                <div class="card" style="width: 18rem;">
                    <img src="~/images/@item.Img" class="card-img-top" alt="@item.Name"
                         onerror="this.onerror=null;this.src='/images/default.jpg';">
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text">@item.Specialization</p>

                        <a href="/Home/BookAppointment?doctorId=@item.Id"  class="btn btn-primary">Book Appointment</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


<div class="row my-5">
    <div class="col-12 d-flex justify-content-center align-content-center">
        <nav aria-label="Page navigation example">
            <ul class="pagination">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item"><a class="page-link" href="/Home/Bookanappointment?page=@i">@i</a></li>
                }
            </ul>
        </nav>
    </div>
</div>
